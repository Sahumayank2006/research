rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Registration documents
    match /registrations/{docId} {
      // Anyone authenticated (including anonymous) can create a registration
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['fullName', 'email', 'mobile', 'participantCategory', 'trackPreference'])
                    && request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.uid == request.auth.uid;

      // Only the owner can read their own registration
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      // No client-side updates or deletes (admin SDK only)
      allow update, delete: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
